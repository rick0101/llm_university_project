# PaperHunter Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM Provider Configuration
# Choose "deepseek" (default) or "google"
LLM_PROVIDER=deepseek

# DeepSeek native API key (if using DeepSeek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key (if using Google)
GOOGLE_API_KEY=your_google_api_key_here

# Semantic Scholar API Key (optional, increases rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# OpenRouter API Key (optional, fallback when Google API fails)
# Registrati su https://openrouter.ai per ottenere una API key
OPENROUTER_API_KEY=

# Rate Limiting
REQUEST_DELAY=1.0
PLAYWRIGHT_DELAY=2.0

# Download Configuration
DOWNLOAD_DIR=./downloads
DOWNLOAD_TIMEOUT=30

# Playwright Configuration
HEADLESS=true
